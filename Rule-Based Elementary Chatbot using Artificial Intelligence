#include <iostream>
#include <string>

using namespace std;

int main() {

    string input;

    cout << "===== AI Customer Chatbot =====\n";

    while(true) {

        cout << "\nYou: ";
        getline(cin, input);

        // Greeting
        if(input == "hello" ||
           input == "hi") {

            cout << "Bot: Hello! Welcome to our service.";
        }

        // Product Information
        else if(input == "product") {

            cout << "Bot: We offer laptops, mobiles and accessories.";
        }

        // Service Details
        else if(input == "service") {

            cout << "Bot: We provide repair and delivery services.";
        }

        // Price Information
        else if(input == "price") {

            cout << "Bot: Prices start from Rs. 10,000.";
        }

        // Shop Timing
        else if(input == "timing") {

            cout << "Bot: Shop timing is 9 AM to 9 PM.";
        }

        // Contact
        else if(input == "contact") {

            cout << "Bot: Contact us at 9876543210.";
        }

        // Exit
        else if(input == "bye") {

            cout << "Bot: Thank you! Have a nice day.";
            break;
        }

        // Unknown Input
        else {

            cout << "Bot: Sorry, I did not understand.";
        }
    }

    return 0;
}
